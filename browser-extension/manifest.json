{
  "manifest_version": 3,
  "name": "Focus Guard Domain Context",
  "description": "Reports only active tab domains to the local Focus Guard backend.",
  "version": "1.0.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Guard Context"
  }
}
